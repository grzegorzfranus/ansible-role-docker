#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}
[Unit]
Description=Docker system prune
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker system prune {{ docker_prune_flags }}
{% if docker_prune_volumes_enabled | bool %}
ExecStart=/usr/local/sbin/docker-prune-volumes
{% endif %}
